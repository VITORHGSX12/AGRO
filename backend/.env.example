# ==============================================================================
# AGRO SaaS Backend - Arquivo de Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais de produção.
# ==============================================================================

# Ambiente de execução ('development' ou 'production')
NODE_ENV=development

# Porta do servidor HTTP
PORT=3001

# Segredo criptográfico para assinatura dos Tokens JWT
# IMPORTANTE: Em produção, gere uma string aleatória forte (mínimo 64 caracteres)
# Exemplo para gerar no terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_longa_e_aleatoria_com_mais_de_64_caracteres_aqui

# Caminho do banco de dados SQLite local ou volume persistente
# Em ambiente de desenvolvimento local, o padrão é './agro.db'
DB_PATH=./agro.db

# URL de conexão caso use PostgreSQL em produção (Etapa 3)
# DATABASE_URL=postgresql://usuario:senha@host:5432/agro_db?sslmode=require

# Domínio do Frontend permitido no CORS (ex: https://meu-agro-app.vercel.app)
# Em desenvolvimento, pode deixar em branco ou http://localhost:5173
CORS_ORIGIN=http://localhost:5173
